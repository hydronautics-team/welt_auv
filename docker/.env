ROS_DOMAIN_ID=1
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
YOLO_WEIGHTS=/home/cherry/Hydronautics/yolov8.pt
YOLO_DEBUG=False
YOLO_IMAGE_TOPIC_LIST=[/zed/zed_node/rgb/color/rect/image,/stingray/topics/camera/bottom]
