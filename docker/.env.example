ROS_DOMAIN_ID=1
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
YOLO_WEIGHTS=../src/sauvc/src/sauvc_object_detection/weights/yolov8.pt
YOLO_DEBUG=True

YOLO_ENABLED_ON_START=True
FRONT_CAMERA_TYPE=zed

ZED_CAMERA_MODEL=zedm
ZED_IMAGE_TOPIC=/zed/zed_node/rgb/color/rect/image
ZED_CAMERA_INFO_TOPIC=/zed/zed_node/rgb/color/rect/camera_info

USB_CAMERA_DEVICE=/dev/video0
USB_CAMERA_WIDTH=640
USB_CAMERA_HEIGHT=480
USB_CAMERA_FPS=30.0

# Published defaults; override these if the onboard registry uses other tags.
CONTROL_IMAGE=hydronautics/welt_auv:control
YOLO_IMAGE=hydronautics/welt_auv:yolo
ZED_IMAGE=hydronautics/welt_auv:zed
YOLO_BASE_IMAGE=hydronautics/od:l4t-r36.3.0
ZED_BASE_IMAGE=stereolabs/zed:5.5-devel-l4t-r36.5
ZED_WRAPPER_REF=master
