ROS_DOMAIN_ID=1
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
YOLO_WEIGHTS=/opt/welt/models/yolov8.pt
YOLO_DEBUG=False
# The onboard default processes the front ZED and the permanent bottom USB camera.
YOLO_IMAGE_TOPIC_LIST=[/zed/zed_node/rgb/color/rect/image,/stingray/topics/camera/bottom]
YOLO_CAMERA_INFO_TOPIC_LIST=[/zed/zed_node/rgb/color/rect/camera_info,/stingray/topics/camera/bottom/camera_info]
ENABLE_BOTTOM_CAMERA=True
BOTTOM_CAMERA_DEVICE=/dev/video2

# Published defaults; override these if the onboard registry uses other tags.
CONTROL_IMAGE=hydronautics/welt_auv:control
YOLO_IMAGE=hydronautics/welt_auv:yolo
ZED_IMAGE=hydronautics/welt_auv:zed
YOLO_BASE_IMAGE=hydronautics/od:l4t-r36.3.0
ZED_BASE_IMAGE=stereolabs/zed:5.5-devel-l4t-r36.5
ZED_WRAPPER_REF=master
