FROM ros:humble-ros-base-jammy

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DOMAIN_ID=1
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl && \
    curl -fsSL \
      https://github.com/ros-infrastructure/ros-apt-source/releases/download/1.3.0/ros2-apt-source_1.3.0.jammy_all.deb \
      -o /tmp/ros2-apt-source.deb && \
    rm -f /etc/apt/sources.list.d/ros2.list \
      /etc/apt/sources.list.d/ros2-latest.list && \
    dpkg -i /tmp/ros2-apt-source.deb && \
    apt-get update && apt-get install -y --no-install-recommends \
      python3-colcon-common-extensions \
      python3-pip \
      ros-humble-cv-bridge \
      ros-humble-rmw-cyclonedds-cpp && \
    rm -f /tmp/ros2-apt-source.deb && rm -rf /var/lib/apt/lists/*

# CUDA-enabled PyTorch for x86_64 NVIDIA workstations. The host driver is
# injected by NVIDIA Container Toolkit at runtime.
RUN python3 -m pip install --no-cache-dir \
      torch torchvision --index-url https://download.pytorch.org/whl/cu121 && \
    python3 -m pip install --no-cache-dir \
      numpy==1.26.4 \
      opencv-python-headless==4.11.0.86 \
      packaging==24.2 scipy pandas matplotlib seaborn pillow pyyaml requests tqdm psutil \
      py-cpuinfo thop filterpy

WORKDIR /welt_auv
COPY . /welt_auv

RUN source /opt/ros/humble/setup.bash && \
    colcon build --cmake-args -DCMAKE_BUILD_TYPE=Release \
      --packages-select \
        stingray_interfaces \
        stingray_object_detection \
        sauvc_object_detection \
        stingray_launch \
        welt_launch

COPY docker/od/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && mkdir -p /models

ENTRYPOINT ["/entrypoint.sh"]
CMD ["ros2", "launch", "welt_launch", "yolo.launch.py", "weights_path:=/models/yolov8.pt", "device:=cuda:0", "require_cuda:=True"]
