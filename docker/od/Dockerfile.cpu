FROM ros:humble-ros-base-jammy

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DOMAIN_ID=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3-colcon-common-extensions \
      python3-pip \
      ros-humble-cv-bridge && \
    rm -rf /var/lib/apt/lists/*

# CPU inference image for developer workstations. Ultralytics itself is
# vendored in stingray_object_detection; only its binary/runtime dependencies
# are installed from wheels here.
RUN python3 -m pip install --no-cache-dir \
      torch torchvision --index-url https://download.pytorch.org/whl/cpu && \
    python3 -m pip install --no-cache-dir \
      numpy==1.26.4 \
      opencv-python-headless==4.11.0.86 \
      packaging==24.2 scipy pandas matplotlib seaborn pillow pyyaml requests tqdm psutil \
      py-cpuinfo thop filterpy

WORKDIR /welt_auv
COPY . /welt_auv

RUN source /opt/ros/humble/setup.bash && \
    colcon build --cmake-args -DCMAKE_BUILD_TYPE=Release \
      --packages-select \
        stingray_interfaces \
        stingray_object_detection \
        sauvc_object_detection \
        stingray_launch \
        welt_launch

COPY docker/od/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && mkdir -p /models

ENTRYPOINT ["/entrypoint.sh"]
CMD ["ros2", "launch", "welt_launch", "yolo.launch.py", "weights_path:=/models/yolov8.pt"]
